{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ragbaz.cc/school/security/manifest.schema.json",
  "title": "RAGBAZ Security School Manifest",
  "type": "object",
  "required": ["version", "library", "themes", "collections", "reservedObjects"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "library": {
      "type": "object",
      "required": ["id", "title", "baseUri", "ownerReader", "restrictedPolicy"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "baseUri": { "type": "string", "pattern": "^crypto://" },
        "ownerReader": { "const": "ragbaz@proton.me" },
        "restrictedPolicy": {
          "type": "object",
          "required": ["state", "authorizedReaders", "privateKeyProvisioned", "clientKeyPersistence", "plaintextCache", "unlockTransport"],
          "properties": {
            "state": { "enum": ["reserved-no-content", "active"] },
            "authorizedReaders": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": { "const": "ragbaz@proton.me" }
            },
            "privateKeyProvisioned": { "type": "boolean" },
            "clientKeyPersistence": { "const": "forbidden" },
            "plaintextCache": { "const": "forbidden" },
            "unlockTransport": { "const": "local-helper-event-only" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "themes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "collections": {
      "type": "array",
      "items": { "$ref": "#/$defs/collection" }
    },
    "reservedObjects": {
      "type": "array",
      "items": { "$ref": "#/$defs/reservedObject" }
    }
  },
  "$defs": {
    "child": {
      "type": "object",
      "required": ["id", "title", "classification"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "classification": { "type": "string", "minLength": 1 },
        "state": { "type": "string" }
      },
      "additionalProperties": false
    },
    "collection": {
      "type": "object",
      "required": ["id", "title", "subtitle", "summary", "status", "classification", "uri", "children"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "summary": { "type": "string" },
        "status": { "type": "string" },
        "classification": { "type": "string" },
        "href": { "type": "string" },
        "uri": { "type": "string", "pattern": "^crypto://ragbaz-security/" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/child" }
        }
      },
      "additionalProperties": false
    },
    "reservedObject": {
      "type": "object",
      "required": ["id", "title", "uri", "classification", "state", "exists", "authorizedReaders", "recipientFingerprints", "ciphertext", "note"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string" },
        "uri": { "type": "string", "pattern": "^crypto://ragbaz-security/" },
        "classification": { "enum": ["controlled-poc", "restricted-implementation"] },
        "state": { "const": "reserved-no-content" },
        "exists": { "const": false },
        "authorizedReaders": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "const": "ragbaz@proton.me" }
        },
        "recipientFingerprints": { "type": "array", "maxItems": 0 },
        "ciphertext": { "type": "null" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
