{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ragbaz-cc",
  "main": "worker.mjs",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/10 * * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "vars": {
    "APP_URL": "https://ragbaz.cc",
    "WORKSPACE_GRAPHQL_UPSTREAM_URL": "",
    "RESEND_FROM": "ragbaz <no-reply@ragbaz.cc>",
  },
  "routes": [
    {
      "pattern": "ragbaz.cc/*",
      "zone_name": "ragbaz.cc",
    },
    {
      "pattern": "www.ragbaz.cc/*",
      "zone_name": "ragbaz.cc",
    },
  ],
  "env": {
    "staging": {
      "routes": [],
      "vars": {
        "APP_URL": "https://staging.ragbaz.cc",
        "WORKSPACE_GRAPHQL_UPSTREAM_URL": "",
        "RESEND_FROM": "ragbaz <no-reply@ragbaz.cc>",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ragbaz-cc-accounts",
          "database_id": "af56c284-f4fa-41ec-bc71-c20dad456dbe",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
  // Secrets (set with `wrangler secret put`): RESEND_API_KEY, SESSION_SECRET,
  // GRAPHQL_SYNC_KEY, WORKSPACE_GRAPHQL_UPSTREAM_KEY
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ragbaz-cc-accounts",
      "database_id": "af56c284-f4fa-41ec-bc71-c20dad456dbe",
      "migrations_dir": "migrations",
    },
  ],
}
